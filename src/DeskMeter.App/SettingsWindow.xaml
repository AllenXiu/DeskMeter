<Window x:Class="DeskMeter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMeter 设置" Width="720" Height="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <!-- Pixso 设计稿样式（Settings Window / 配置 / 关于 三帧）：
         深色主题 bg=#12141A surface=#1C1F26 border=#2A2E37 textPrimary=#F2F3F5
         primary=#4C8DFF；自定义标题栏 + 左侧导航 + 底部操作栏 -->
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#12141A" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1F26" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#2A2E37" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB4BF" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7E8594" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4C8DFF" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#24324A" />

        <Style TargetType="Button" x:Key="BtnSecondary">
            <Setter Property="Background" Value="#1C1F26" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="BorderBrush" Value="#2A2E37" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#242A35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A303C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BtnPrimary" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Background" Value="#4C8DFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4C8DFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6BA0FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3B7BE8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12141A" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="BorderBrush" Value="#2A2E37" />
            <Setter Property="CaretBrush" Value="#F2F3F5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#12141A" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="BorderBrush" Value="#2A2E37" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#242A35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24324A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- 标题栏：D 图标 + 标题 + 版本 Badge + 关闭 -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}">
                        <TextBlock Text="D" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="DeskMeter 设置" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource PrimarySoftBrush}" CornerRadius="4"
                        Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadgeText" Text="v0.1.0" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                </Border>
                <Button Grid.Column="3" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                        Click="OnCloseClick" Cursor="Hand" VerticalAlignment="Center" Width="28" Height="28"
                        ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E5534B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body：左侧导航 + 内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <StackPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}" Margin="0,1,1,0">
                    <Border Height="12" Background="Transparent" />
                    <Border x:Name="NavGeneral" CornerRadius="8" Background="{StaticResource PrimarySoftBrush}" Padding="10,9" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="OnNavGeneral">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="常规" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavConfig" CornerRadius="8" Background="Transparent" Padding="10,9" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="OnNavConfig">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="配置" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavAbout" CornerRadius="8" Background="Transparent" Padding="10,9" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="OnNavAbout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="关于" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 内容区 -->
                <Grid Grid.Column="1" Margin="24,24,24,16">
                    <!-- 常规 -->
                    <Grid x:Name="GeneralPage" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="刷新间隔（秒）" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,10" />
                        <TextBox x:Name="IntervalBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="点击穿透" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,10" />
                        <CheckBox x:Name="ClickThroughBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="开机自启" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,10" />
                        <CheckBox x:Name="AutostartBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="显示器" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,10" />
                        <ComboBox x:Name="MonitorBox" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="配置文件" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,10" />
                        <TextBlock x:Name="ConfigPathText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" FontSize="12" />
                    </Grid>

                    <!-- 配置（多配置管理） -->
                    <Grid x:Name="ConfigPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ConfigList" Grid.Column="0"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="4"
                                     SelectionChanged="OnConfigSelectionChanged"
                                     MouseDoubleClick="OnConfigDoubleClick" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                                <Button Content="导入配置…" Click="OnImportConfig" Style="{StaticResource BtnPrimary}" Width="110" Margin="0,0,0,8" />
                                <Button Content="设为当前" Click="OnSwitchConfig" Style="{StaticResource BtnSecondary}" Width="110" Margin="0,0,0,8" />
                                <Button Content="重命名" Click="OnRenameConfig" Style="{StaticResource BtnSecondary}" Width="110" Margin="0,0,0,8" />
                                <Button Content="删除" Click="OnDeleteConfig" Style="{StaticResource BtnSecondary}" Width="110" Margin="0,0,0,8" />
                                <Button Content="用记事本编辑" Click="OnOpenExternalEditor" Style="{StaticResource BtnSecondary}" Width="110" Margin="0,0,0,8" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="当前配置以粗体显示；切换后小部件立即热重载。" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0" />
                    </Grid>

                    <!-- 关于 -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed" VerticalAlignment="Top" Width="420">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}">
                                <TextBlock Text="D" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DeskMeter" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="AboutVersionText" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Conky 风格的 Windows 桌面系统监控小部件。配置驱动、透明融入壁纸、无广告无遥测。"
                                   TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="许可证：MIT" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="配置目录：" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="AboutConfigPath" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12" />
                        <TextBlock Text="主页：" Foreground="{StaticResource TextPrimaryBrush}">
                            <Hyperlink x:Name="HomeLink" NavigateUri="https://github.com/AllenXiu/DeskMeter"
                                       RequestNavigate="OnNavigate" Foreground="{StaticResource PrimaryBrush}">github.com/AllenXiu/DeskMeter</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 底部操作栏：恢复默认 / 取消 / 保存 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                <Button Content="恢复默认" Click="OnRestoreDefault" Style="{StaticResource BtnSecondary}" Width="100" Margin="0,0,10,0" />
                <Button Content="取消" Click="OnCancel" Style="{StaticResource BtnSecondary}" Width="88" Margin="0,0,10,0" />
                <Button Content="保存" Click="OnSave" Style="{StaticResource BtnPrimary}" Width="88" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
