<Window x:Class="DeskMeter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskMeter.App"
        Title="DeskMeter 设置" Width="720" Height="540"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#D4D4D4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#252526" BorderBrush="#3F3F46">
            <!-- 常规 -->
            <TabItem Header="常规">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="刷新间隔（秒）" VerticalAlignment="Center" />
                    <TextBox x:Name="IntervalBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                             Margin="0,4" Padding="4,2" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3F3F46" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="点击穿透" VerticalAlignment="Center" />
                    <CheckBox x:Name="ClickThroughBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="开机自启" VerticalAlignment="Center" />
                    <CheckBox x:Name="AutostartBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="显示器" VerticalAlignment="Center" />
                    <ComboBox x:Name="MonitorBox" Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              Margin="0,6" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3F3F46" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="配置文件" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConfigPathText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="#9CDCFE" />
                </Grid>
            </TabItem>

            <!-- 配置 -->
            <TabItem Header="配置">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:ConkyCodeEditor x:Name="Editor" Grid.Row="0" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="修改后点「保存」即热重载生效（桌面即预览）" Foreground="#858585" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="恢复默认" Click="OnRestoreDefault" Width="90" Padding="8,3" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="关于">
                <StackPanel Margin="28,24" VerticalAlignment="Top" Width="420">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="48" Height="48" CornerRadius="8" Background="#1F3A5F">
                            <TextBlock Text="D" FontSize="30" FontWeight="Bold" Foreground="#88CCFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeskMeter" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="AboutVersionText" Foreground="#858585" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Conky 风格的 Windows 桌面系统监控小部件。配置驱动、透明融入壁纸、无广告无遥测。" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <TextBlock Text="许可证：MIT" Margin="0,0,0,8" />
                    <TextBlock Text="配置文件：" Margin="0,0,0,4" Foreground="#858585" />
                    <TextBlock x:Name="AboutConfigPath" Foreground="#9CDCFE" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="主页：">
                        <Hyperlink x:Name="HomeLink" NavigateUri="https://github.com/AllenXiu/DeskMeter"
                                   RequestNavigate="OnNavigate">github.com/AllenXiu/DeskMeter</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Click="OnCancel" Width="88" Padding="8,4" Margin="0,0,10,0" />
            <Button Content="保存" Click="OnSave" Width="88" Padding="8,4" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
