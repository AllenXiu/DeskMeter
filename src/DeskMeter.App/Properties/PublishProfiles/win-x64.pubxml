<?xml version="1.0" encoding="utf-8"?>
<!--
  发布配置（配合 .github/workflows/release.yml 或本地命令）：
    dotnet publish src/DeskMeter.App/DeskMeter.App.csproj -p:PublishProfile=win-x64
  win-x64 自包含单文件（含原生库解包），输出含 samples/conky.conf。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>binRelease
et8.0-windowswin-x64publish</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
