<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeskMeter.App</RootNamespace>
    <AssemblyName>DeskMeter</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- NFR-2 内存 <100MB：限制托管堆硬上限（32MB，实际稳态 gcHeap 仅 2-3MB，10 倍余量），
       阻止 1Hz 刷新产生的垃圾导致堆段无限增长；GC 更频繁但堆小、开销可忽略 -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="33554432" />
  </ItemGroup>
  <!-- WPF + WinForms 混用：移除隐式 using，消除 Application/Color 等二义（需处显式 using） -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeskMeter.Core\DeskMeter.Core.csproj" />
    <ProjectReference Include="..\DeskMeter.Core.Windows\DeskMeter.Core.Windows.csproj" />
    <ProjectReference Include="..\DeskMeter.Render\DeskMeter.Render.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\samples\conky.conf" Link="samples\conky.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
