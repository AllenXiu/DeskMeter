<Window x:Class="DeskMeter.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F8FA" Foreground="#1F2329" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="#1F2329" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" Background="#FFFFFF" Foreground="#1F2329" BorderBrush="#E6E8EB"
                 Padding="4,2" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="72" Padding="6,3" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="确定" Width="72" Padding="6,3" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
